# Copie para .env e preencha. O .env nunca vai para o GitHub.

# Supabase → Project Settings → API Keys / Data API
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=      # "publishable" (sb_publishable_...) ou "anon" — pode ir no site
SUPABASE_SECRET_KEY=           # "secret" (sb_secret_...) ou "service_role" — SÓ servidor
SUPABASE_DB_PASSWORD=          # senha do banco definida ao criar o projeto

# Pluggy → dashboard.pluggy.ai → Applications
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=          # SÓ servidor
PLUGGY_TRIAL_INICIO=           # data em que a conta foi criada (AAAA-MM-DD)

# Resend → API Keys (permissão "Sending access")
RESEND_API_KEY=

# brapi.dev → Dashboard → token
BRAPI_TOKEN=
